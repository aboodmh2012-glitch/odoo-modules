<odoo>
    <record id="corporate_compliance_view_form" model="ir.ui.view">
        <field name="name">corporate.compliance.event.form</field>
        <field name="model">corporate.compliance.event</field>
        <field name="arch" type="xml">
            <form string="Compliance event">
                <header>
                    <button name="action_complete" string="Mark complete" type="object"
                            class="btn-primary" invisible="completed_date"/>
                    <button name="action_reset" string="Reset" type="object"
                            invisible="not completed_date"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="upcoming,due_soon,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Details">
                            <field name="event_type"/>
                            <field name="fiscal_year"/>
                            <field name="due_date"/>
                            <field name="completed_date"/>
                        </group>
                        <group string="Reference">
                            <field name="resolution_id"/>
                            <field name="filing_reference"/>
                            <field name="reminder_sent" groups="base.group_no_one"/>
                            <field name="reminder_due_date" groups="base.group_no_one"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="corporate_compliance_view_list" model="ir.ui.view">
        <field name="name">corporate.compliance.event.list</field>
        <field name="model">corporate.compliance.event</field>
        <field name="arch" type="xml">
            <list string="Compliance events"
                  decoration-danger="status == 'overdue'"
                  decoration-warning="status == 'due_soon'"
                  decoration-success="status == 'upcoming'"
                  decoration-muted="status == 'completed'">
                <field name="name"/>
                <field name="event_type"/>
                <field name="fiscal_year" optional="show"/>
                <field name="due_date"/>
                <field name="completed_date"/>
                <field name="filing_reference" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="status" widget="badge"
                       decoration-danger="status == 'overdue'"
                       decoration-warning="status == 'due_soon'"
                       decoration-success="status == 'upcoming'"
                       decoration-muted="status == 'completed'"/>
            </list>
        </field>
    </record>

    <record id="corporate_compliance_view_calendar" model="ir.ui.view">
        <field name="name">corporate.compliance.event.calendar</field>
        <field name="model">corporate.compliance.event</field>
        <field name="arch" type="xml">
            <calendar string="Compliance calendar" date_start="due_date"
                      color="event_type" mode="year">
                <field name="name"/>
                <field name="status"/>
            </calendar>
        </field>
    </record>

    <record id="corporate_compliance_view_search" model="ir.ui.view">
        <field name="name">corporate.compliance.event.search</field>
        <field name="model">corporate.compliance.event</field>
        <field name="arch" type="xml">
            <search string="Search compliance events">
                <field name="name"/>
                <field name="fiscal_year"/>
                <separator/>
                <filter string="Overdue" name="overdue"
                        domain="[('status', '=', 'overdue')]"/>
                <filter string="Due soon" name="due_soon"
                        domain="[('status', '=', 'due_soon')]"/>
                <filter string="Upcoming" name="upcoming"
                        domain="[('status', '=', 'upcoming')]"/>
                <filter string="Completed" name="completed"
                        domain="[('status', '=', 'completed')]"/>
                <separator/>
                <filter string="Open" name="pending"
                        domain="[('completed_date', '=', False)]"/>
                <separator/>
                <group>
                    <filter string="Type" name="group_type"
                            context="{'group_by': 'event_type'}"/>
                    <filter string="Status" name="group_status"
                            context="{'group_by': 'status'}"/>
                    <filter string="Fiscal year" name="group_fiscal_year"
                            context="{'group_by': 'fiscal_year'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="corporate_compliance_action" model="ir.actions.act_window">
        <field name="name">Compliance calendar</field>
        <field name="res_model">corporate.compliance.event</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="search_view_id" ref="corporate_compliance_view_search"/>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first compliance event
            </p>
        </field>
    </record>

    <record id="corporate_minute_book_action" model="ir.actions.act_window">
        <field name="name">Minute Book</field>
        <field name="res_model">document.page</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('minute_book_section', '!=', False)]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Classify a Knowledge page with a Minute Book section to list it here.
            </p>
        </field>
    </record>
</odoo>
