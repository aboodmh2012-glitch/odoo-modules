<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <data noupdate="0">
    <record id="module_category_corporate" model="ir.module.category">
      <field name="name">Corporate Governance</field>
      <field name="sequence">33</field>
    </record>
    <record id="corporate_privilege" model="res.groups.privilege">
      <field name="name">Corporate Governance</field>
      <field name="category_id" ref="module_category_corporate" />
    </record>
    <record id="group_corporate_user" model="res.groups">
      <field name="name">User</field>
      <field name="privilege_id" ref="corporate_privilege" />
      <field name="implied_ids" eval="[(4, ref('knowledge_control.group_knowledge_control_user'))]" />
    </record>
    <record id="group_corporate_secretary" model="res.groups">
      <field name="name">Board Secretary</field>
      <field name="comment">Operational board-secretariat role: prepare meetings, agenda,
        attendance, draft minutes and draft resolutions. NOT a board member, no
        vote, cannot adopt resolutions on the board's behalf.</field>
      <field name="privilege_id" ref="corporate_privilege" />
      <field name="implied_ids" eval="[(4, ref('group_corporate_user'))]" />
    </record>
    <record id="group_corporate_manager" model="res.groups">
      <field name="name">Manager</field>
      <field name="comment">Full access to resolutions, directors, officers, compliance.</field>
      <field name="privilege_id" ref="corporate_privilege" />
      <field name="implied_ids" eval="[(4, ref('group_corporate_secretary'))]" />
      <field name="user_ids" eval="[(4, ref('base.user_admin'))]" />
    </record>
  </data>

  <data noupdate="1">
    
    </data>
</odoo>