<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_masar_knowledge_tag_list" model="ir.ui.view">
    <field name="name">masar.knowledge.tag.list</field>
    <field name="model">masar.knowledge.tag</field>
    <field name="arch" type="xml">
      <list editable="bottom">
        <field name="name"/>
        <field name="color" widget="color_picker"/>
      </list>
    </field>
  </record>
  <record id="action_masar_knowledge_tag" model="ir.actions.act_window">
    <field name="name">Knowledge Tags</field>
    <field name="res_model">masar.knowledge.tag</field>
    <field name="view_mode">list</field>
  </record>
  <menuitem id="menu_masar_knowledge_tag"
            name="Knowledge Tags"
            parent="document_knowledge.menu_document_configuration"
            action="action_masar_knowledge_tag"
            sequence="50"/>
</odoo>
