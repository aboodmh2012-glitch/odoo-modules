<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_employee_document_list" model="ir.ui.view">
    <field name="name">hr.employee.document.list</field>
    <field name="model">hr.employee.document</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="employee_id"/>
        <field name="document_type_id"/>
        <field name="issue_date"/>
        <field name="expiry_date"/>
        <field name="is_confidential"/>
        <field name="state"/>
      </list>
    </field>
  </record>
  <record id="view_employee_document_form" model="ir.ui.view">
    <field name="name">hr.employee.document.form</field>
    <field name="model">hr.employee.document</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="employee_id"/>
              <field name="document_type_id"/>
              <field name="issue_date"/>
              <field name="expiry_date"/>
              <field name="state"/>
            </group>
            <group>
              <field name="notification_type"/>
              <field name="before_days"/>
              <field name="last_reminder_date" readonly="1"/>
              <field name="is_confidential"/>
              <field name="company_id" groups="base.group_multi_company"/>
            </group>
          </group>
          <field name="description"/>
          <field name="attachment_ids" widget="many2many_binary"/>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="view_employee_document_search" model="ir.ui.view">
    <field name="name">hr.employee.document.search</field>
    <field name="model">hr.employee.document</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="employee_id"/>
        <filter name="expired" string="Expired" domain="[('state', '=', 'expired')]"/>
        <filter name="expiring" string="Expiring Soon" domain="[('state', '=', 'expiring_soon')]"/>
        <filter name="confidential" string="Confidential" domain="[('is_confidential', '=', True)]"/>
      </search>
    </field>
  </record>
  <record id="action_employee_document" model="ir.actions.act_window">
    <field name="name">Employee Documents</field>
    <field name="res_model">hr.employee.document</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
