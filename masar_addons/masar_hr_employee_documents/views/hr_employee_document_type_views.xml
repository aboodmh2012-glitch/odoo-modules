<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_document_type_list" model="ir.ui.view">
    <field name="name">hr.employee.document.type.list</field>
    <field name="model">hr.employee.document.type</field>
    <field name="arch" type="xml">
      <list>
        <field name="code"/>
        <field name="name"/>
        <field name="checklist_kind"/>
        <field name="requires_expiry"/>
        <field name="confidential_default"/>
        <field name="default_notify_days"/>
      </list>
    </field>
  </record>
  <record id="view_document_type_form" model="ir.ui.view">
    <field name="name">hr.employee.document.type.form</field>
    <field name="model">hr.employee.document.type</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="code"/>
            <field name="checklist_kind"/>
            <field name="requires_expiry"/>
            <field name="confidential_default"/>
            <field name="default_notify_days"/>
            <field name="active"/>
            <field name="company_id" groups="base.group_multi_company"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_document_type" model="ir.actions.act_window">
    <field name="name">Document Types</field>
    <field name="res_model">hr.employee.document.type</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
