<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Employees see their own documents EXCEPT confidential (HR-only) ones such
       as disciplinary, medical or investigation files. HR keeps full access via
       rule_document_hr (record rules OR across a user's groups). -->
  <record id="rule_document_own" model="ir.rule">
    <field name="name">Employee document: own (non-confidential)</field>
    <field name="model_id" ref="model_hr_employee_document"/>
    <field name="domain_force">[('employee_id', 'in', user.employee_ids.ids), ('is_confidential', '=', False)]</field>
    <field name="groups" eval="[(4, ref('base.group_user'))]"/>
  </record>
  <record id="rule_document_hr" model="ir.rule">
    <field name="name">Employee document: HR all</field>
    <field name="model_id" ref="model_hr_employee_document"/>
    <field name="domain_force">[(1, '=', 1)]</field>
    <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
  </record>
  <record id="rule_document_company" model="ir.rule">
    <field name="name">Employee document multi-company</field>
    <field name="model_id" ref="model_hr_employee_document"/>
    <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    <field name="global" eval="True"/>
  </record>
  <record id="rule_document_type_company" model="ir.rule">
    <field name="name">Document type multi-company</field>
    <field name="model_id" ref="model_hr_employee_document_type"/>
    <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    <field name="global" eval="True"/>
  </record>
</odoo>
