<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="portal_tickets" model="portal.entry">
        <field name="name">Tickets</field>
        <field name="description">Follow and comment your helpdesk tickets</field>
        <field name="url">/my/tickets</field>
        <field name="image" type="bytes" file="helpdesk_mgmt/static/src/img/helpdesk_icon.svg"/>
        <field name="placeholder_count">ticket_count</field>
        <field name="category">common_category</field>
        <field name="sequence" eval="80"/>
    </record>
</odoo>
