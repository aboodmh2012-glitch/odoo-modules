<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="masar_homepage_content_refresh" inherit_id="website.homepage" name="MASAR Homepage Content Refresh" priority="120">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="oe_structure masar-site masar-pay">
                <t t-set="copy" t-value="website.masar_public()"/>

                <section class="masar-hero masar-hero--home">
                    <div class="masar-sky" aria-hidden="true">
                        <svg class="masar-sky__svg" viewBox="0 0 1440 520" preserveAspectRatio="xMidYMax slice">
                            <path class="masar-sky__ridge" d="M0 360 C180 300 260 330 420 280 C560 240 640 300 820 250 C980 210 1100 260 1280 220 C1360 200 1400 230 1440 210 V520 H0 Z"/>
                            <g class="masar-sky__city">
                                <rect x="180" y="250" width="36" height="150"/>
                                <rect x="230" y="210" width="28" height="190"/>
                                <rect x="270" y="170" width="22" height="230"/>
                                <rect x="304" y="230" width="40" height="170"/>
                                <rect x="360" y="190" width="18" height="210"/>
                                <rect x="520" y="240" width="46" height="160"/>
                                <rect x="580" y="200" width="24" height="200"/>
                                <rect x="616" y="160" width="30" height="240"/>
                                <rect x="660" y="220" width="50" height="180"/>
                                <rect x="900" y="230" width="34" height="170"/>
                                <rect x="948" y="180" width="20" height="220"/>
                                <rect x="980" y="210" width="42" height="190"/>
                                <rect x="1120" y="200" width="26" height="200"/>
                                <rect x="1160" y="240" width="48" height="160"/>
                            </g>
                        </svg>
                    </div>
                    <div class="masar-wrap masar-hero__top">
                        <div class="masar-hero__copy">
                            <p class="masar-eyebrow masar-hero__badge" t-out="copy['home']['hero']['eyebrow']"/>
                            <h1 class="masar-hero__title">
                                <t t-foreach="copy['home']['hero']['title_parts']" t-as="part">
                                    <span t-attf-class="masar-hero__part masar-hero__part--#{part['tone']} #{part['break_before'] and 'masar-hero__part--break' or ''}" t-out="part['text']"/>
                                </t>
                            </h1>
                            <p class="masar-hero__lead" t-out="copy['home']['hero']['lead']"/>
                            <div class="masar-hero__actions">
                                <a class="masar-btn masar-btn--primary masar-btn--forward" t-att-href="copy['actions']['get_started_href']">
                                    <span class="masar-btn__label" t-out="copy['actions']['get_started']"/>
                                </a>
                                <a class="masar-btn masar-btn--ghost masar-btn--forward" t-att-href="copy['actions']['explore_services_href']">
                                    <span class="masar-btn__label" t-out="copy['actions']['explore_services']"/>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="masar-wrap masar-stage" aria-hidden="true">
                        <div class="masar-stage__arc"/>
                        <div class="masar-device masar-device--phone">
                            <div class="masar-phone">
                                <div class="masar-phone__screen">
                                    <span class="masar-dash__brand" t-out="copy['brand']['name']"/>
                                    <span class="masar-phone__apps">
                                        <span t-foreach="copy['home']['hero']['phone_apps']" t-as="app" class="masar-phone__app">
                                            <span class="masar-phone__glyph"/>
                                            <span class="masar-phone__name" t-out="app"/>
                                        </span>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="masar-device masar-device--laptop">
                            <div class="masar-dash">
                                <div class="masar-dash__top">
                                    <span class="masar-dash__brand" t-out="copy['brand']['name']"/>
                                </div>
                                <div class="masar-dash__metrics">
                                    <span t-foreach="copy['home']['hero']['metrics']" t-as="metric" class="masar-dash__metric">
                                        <span class="masar-dash__value" t-out="metric['value']"/>
                                        <span class="masar-dash__label" t-out="metric['label']"/>
                                    </span>
                                </div>
                                <div class="masar-dash__chart" aria-hidden="true">
                                    <span class="masar-dash__bar"/>
                                    <span class="masar-dash__bar"/>
                                    <span class="masar-dash__bar"/>
                                    <span class="masar-dash__bar"/>
                                    <span class="masar-dash__bar"/>
                                    <span class="masar-dash__bar"/>
                                    <span class="masar-dash__bar"/>
                                </div>
                            </div>
                        </div>
                        <div class="masar-device masar-device--pos">
                            <div class="masar-pos">
                                <span class="masar-pos__screen" t-out="copy['brand']['product']"/>
                                <span class="masar-pos__keys"/>
                            </div>
                        </div>
                        <div class="masar-device masar-device--atm">
                            <div class="masar-atm">
                                <span class="masar-atm__screen">
                                    <span class="masar-dash__brand" t-out="copy['brand']['name']"/>
                                </span>
                                <span class="masar-atm__slot"/>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="masar-section masar-trust-band">
                    <div class="masar-wrap">
                        <ul class="masar-trust">
                            <li t-foreach="copy['home']['trust']" t-as="item" class="masar-trust__item">
                                <span class="masar-trust__icon">
                                    <t t-set="icon" t-value="item['icon']"/>
                                    <t t-call="masar_website.masar_icon"/>
                                </span>
                                <span class="masar-trust__copy">
                                    <span class="masar-trust__title" t-out="item['title']"/>
                                    <span class="masar-trust__text" t-out="item['text']"/>
                                </span>
                            </li>
                        </ul>
                    </div>
                </section>

                <section class="masar-section masar-services-showcase" id="services">
                    <div class="masar-wrap">
                        <div class="masar-section-head">
                            <div class="masar-section-head__copy">
                                <p class="masar-section-head__eyebrow" t-out="copy['home']['services_intro']['eyebrow']"/>
                                <h2 class="masar-section-head__title" t-out="copy['home']['services_intro']['title']"/>
                                <p class="masar-section-head__lead" t-out="copy['home']['services_intro']['lead']"/>
                            </div>
                            <a class="masar-section-head__link masar-textlink masar-textlink--forward" t-att-href="copy['actions']['explore_services_href']">
                                <span t-out="copy['actions']['explore_services']"/>
                            </a>
                        </div>
                        <t t-set="service_images" t-value="('gateway', 'pos', 'accounts', 'bulk', 'bills', 'atm')"/>

                        <!-- Wide screens: editorial grid. Narrow screens: the same cards as a carousel. -->
                        <div class="masar-service-carousel" data-masar-carousel="services">
                            <div class="masar-service-grid" aria-label="Payment services">
                                <a t-foreach="copy['home']['offers']" t-as="offer"
                                   t-attf-class="masar-service-card masar-service-card--#{offer_index &lt; 2 and 'anchor' or 'compact'}"
                                   t-att-href="offer['href']">
                                    <span class="masar-service-card__media">
                                        <img t-att-src="'/masar_website/static/src/img/services-v2/%s.webp?v=20260928-svc' % service_images[offer_index]"
                                             t-att-alt="offer['title']" loading="lazy" width="1280" height="720"/>
                                        <span class="masar-service-card__number" t-out="'0%s' % (offer_index + 1)"/>
                                    </span>
                                    <div class="masar-service-card__content">
                                        <header class="masar-service-card__header">
                                            <span class="masar-service-card__icon">
                                                <t t-set="icon" t-value="offer['icon']"/>
                                                <t t-call="masar_website.masar_icon"/>
                                            </span>
                                            <h3 class="masar-service-card__title" t-out="offer['title']"/>
                                        </header>
                                        <div class="masar-service-card__body">
                                            <p class="masar-service-card__text" t-out="offer['text']"/>
                                        </div>
                                    </div>
                                </a>
                            </div>
                            <div class="masar-service-carousel__bar">
                                <button type="button" class="masar-service-carousel__nav masar-service-carousel__nav--prev" t-att-aria-label="copy['actions']['carousel_prev']"/>
                                <div class="masar-service-carousel__dots"/>
                                <button type="button" class="masar-service-carousel__nav masar-service-carousel__nav--next" t-att-aria-label="copy['actions']['carousel_next']"/>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="masar-section masar-audience-band">
                    <div class="masar-wrap masar-audience">
                        <article t-foreach="copy['home']['audiences']" t-as="card" t-attf-class="masar-audience__card masar-audience__card--#{card['tone']}">
                            <p class="masar-audience__kicker" t-out="card['kicker']"/>
                            <h2 class="masar-audience__title" t-out="card['title']"/>
                            <ul class="masar-points">
                                <li t-foreach="card['points']" t-as="point" class="masar-points__item">
                                    <span class="masar-points__mark" aria-hidden="true"/>
                                    <span class="masar-points__text" t-out="point"/>
                                </li>
                            </ul>
                            <a class="masar-btn masar-btn--primary masar-btn--forward" t-att-href="copy['actions'][card['action'] + '_href']">
                                <span class="masar-btn__label" t-out="copy['actions'][card['action']]"/>
                            </a>
                        </article>
                    </div>
                </section>

                <section class="masar-section" id="about">
                    <div class="masar-wrap">
                        <div class="masar-principles">
                            <article t-foreach="copy['home']['principles']" t-as="column" class="masar-principle">
                                <header class="masar-principle__header masar-principle__heading">
                                    <span t-if="'icon' in column and column['icon']" class="masar-principle__icon" aria-hidden="true">
                                        <t t-set="icon" t-value="column['icon']"/>
                                        <t t-call="masar_website.masar_icon"/>
                                    </span>
                                    <h2 class="masar-principle__title" t-out="column['title']"/>
                                </header>
                                <div class="masar-principle__body">
                                    <ul t-if="'lines' in column" class="masar-principle__lines">
                                        <li t-foreach="column['lines']" t-as="line" class="masar-principle__line" t-out="line"/>
                                    </ul>
                                    <p t-if="'text' in column" class="masar-principle__text" t-out="column['text']"/>
                                </div>
                            </article>
                        </div>
                        <t t-set="path_banner" t-value="copy['home']['path_banner']"/>
                        <article class="masar-path-banner">
                            <header class="masar-path-banner__header">
                                <span class="masar-path-banner__icon" aria-hidden="true">
                                    <t t-set="icon" t-value="path_banner['icon']"/>
                                    <t t-call="masar_website.masar_icon"/>
                                </span>
                                <h2 class="masar-path-banner__title" t-out="path_banner['title']"/>
                            </header>
                            <div class="masar-path-banner__body">
                                <p class="masar-path-banner__text" t-out="path_banner['text']"/>
                                <a t-if="'link' in path_banner" class="masar-textlink masar-textlink--forward" t-att-href="copy['actions'][path_banner['link'] + '_href']">
                                    <span t-out="copy['actions'][path_banner['link']]"/>
                                </a>
                            </div>
                        </article>
                    </div>
                </section>

                <section class="masar-band masar-opportunity">
                    <div class="masar-wrap masar-opportunity__inner">
                        <h2 class="masar-opportunity__title" t-out="copy['home']['opportunity']['title']"/>
                        <t t-call="masar_website.masar_lockup"/>
                    </div>
                </section>

                <t t-call="masar_website.masar_closing"/>
            </div>
        </xpath>
    </template>

    <template id="masar_solutions_page" name="MASAR Solutions">
        <t t-set="page_key" t-value="'services'"/>
        <t t-call="masar_website.masar_simple_page"/>
    </template>
    <record id="masar_solutions_page_page" model="website.page">
        <field name="name">Services</field>
        <field name="website_published">True</field>
        <field name="url">/solutions</field>
        <field name="view_id" ref="masar_solutions_page"/>
        <field name="website_meta_title">Services | MASAR Pay</field>
        <field name="website_meta_description">Payment gateway, POS, accounts and cards, bulk payments, bill payments, and cash access.</field>
    </record>

    <template id="masar_business_page" name="MASAR for Business">
        <t t-set="page_key" t-value="'business'"/>
        <t t-call="masar_website.masar_simple_page"/>
    </template>
    <record id="masar_business_page_page" model="website.page">
        <field name="name">Businesses</field>
        <field name="website_published">True</field>
        <field name="url">/business</field>
        <field name="view_id" ref="masar_business_page"/>
        <field name="website_meta_title">For Businesses | MASAR Pay</field>
        <field name="website_meta_description">Payment solutions that help businesses accept, manage, and scale digital payments.</field>
    </record>

    <template id="masar_about_page" name="About MASAR">
        <t t-set="page_key" t-value="'about'"/>
        <t t-call="masar_website.masar_simple_page"/>
    </template>
    <record id="masar_about_page_page" model="website.page">
        <field name="name">About MASAR</field>
        <field name="website_published">True</field>
        <field name="url">/about</field>
        <field name="view_id" ref="masar_about_page"/>
        <field name="website_meta_title">About MASAR Pay</field>
        <field name="website_meta_description">MASAR Pay is a Yemeni payment services company licensed by the Central Bank of Yemen.</field>
    </record>

    <template id="masar_security_compliance_page" name="MASAR Security and Compliance">
        <t t-set="page_key" t-value="'security'"/>
        <t t-call="masar_website.masar_simple_page"/>
    </template>
    <record id="masar_security_compliance_page_page" model="website.page">
        <field name="name">Security &amp; Compliance</field>
        <field name="website_published">True</field>
        <field name="url">/security-compliance</field>
        <field name="view_id" ref="masar_security_compliance_page"/>
        <field name="website_meta_title">Security &amp; Compliance | MASAR Pay</field>
        <field name="website_meta_description">How MASAR Pay approaches data protection, access control, monitoring, and auditability.</field>
    </record>
</odoo>
