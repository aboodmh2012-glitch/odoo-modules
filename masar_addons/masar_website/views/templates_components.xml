    <template id="masar_icon" name="MASAR icon">
        <svg class="masar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <use t-attf-href="#masar-i-#{icon}"/>
        </svg>
    </template>

    <template id="masar_paymarks" name="MASAR payment marks">
        <div class="masar-paymarks">
            <ul class="masar-paymarks__track">
                <li class="masar-paymark">
                    <svg class="masar-paymark__svg masar-paymark__svg--visa" viewBox="0 0 72 24" role="img" aria-label="Visa">
                        <text x="0" y="18" fill="#ffffff" font-family="Arial, sans-serif" font-size="18" font-weight="800">VISA</text>
                    </svg>
                </li>
                <li class="masar-paymark">
                    <svg class="masar-paymark__svg masar-paymark__svg--mastercard" viewBox="0 0 40 24" role="img" aria-label="Mastercard">
                        <circle cx="15" cy="12" r="8" fill="#eb001b"/>
                        <circle cx="25" cy="12" r="8" fill="#f79e1b" fill-opacity="0.95"/>
                    </svg>
                </li>
                <li class="masar-paymark">
                    <svg class="masar-paymark__svg masar-paymark__svg--apple" viewBox="0 0 92 24" role="img" aria-label="Apple Pay">
                        <path fill="#ffffff" d="M7.2 7.1c.4-.5.7-1.2.6-1.9-.6 0-1.4.4-1.8.9-.4.5-.7 1.2-.6 1.9.7.1 1.4-.3 1.8-.9zm.6.9c-1 0-1.8.6-2.3.6s-1.2-.5-2-.5c-1 0-2 .6-2.5 1.5-1.1 1.9-.3 4.7.7 6.2.5.8 1.1 1.6 1.9 1.6.7 0 1-.5 1.9-.5s1.1.5 1.9.5 1.3-.8 1.8-1.6c.6-.9.8-1.7.8-1.8-.1 0-1.6-.6-1.6-2.4 0-1.5 1.2-2.2 1.3-2.3-.7-1-1.8-1.2-2.1-1.3z"/>
                        <text x="16" y="17" fill="#ffffff" font-family="Arial, sans-serif" font-size="13" font-weight="600">Pay</text>
                    </svg>
                </li>
                <li class="masar-paymark">
                    <svg class="masar-paymark__svg masar-paymark__svg--gpay" viewBox="0 0 92 24" role="img" aria-label="Google Pay">
                        <path fill="#4285F4" d="M21.2 12.2c0-.6-.1-1.2-.2-1.7H12v3.2h5.2c-.2 1.2-.9 2.2-1.9 2.8v2.3h3.1c1.8-1.6 2.8-4.1 2.8-6.6z"/>
                        <path fill="#34A853" d="M12 22c2.6 0 4.7-.8 6.3-2.3l-3.1-2.3c-.8.6-1.9.9-3.2.9-2.5 0-4.6-1.7-5.3-3.9H3.5v2.4C5.1 19.9 8.3 22 12 22z"/>
                        <path fill="#FBBC05" d="M6.7 14.4A6 6 0 0 1 6.4 12c0-.8.1-1.6.3-2.4V7.2H3.5A10 10 0 0 0 2.4 12c0 1.6.4 3.1 1.1 4.4l3.2-2z"/>
                        <path fill="#EA4335" d="M12 5.8c1.4 0 2.7.5 3.6 1.4l2.7-2.7C16.7 2.9 14.6 2 12 2 8.3 2 5.1 4.1 3.5 7.2l3.2 2.4C7.4 7.4 9.5 5.8 12 5.8z"/>
                        <text x="26" y="16.5" fill="#ffffff" font-family="Arial, sans-serif" font-size="13" font-weight="600">Pay</text>
                    </svg>
                </li>
                <li class="masar-paymark">
                    <span class="masar-paymark__bank" aria-hidden="true">
                        <t t-set="icon" t-value="'building'"/>
                        <t t-call="masar_website.masar_icon"/>
                    </span>
                </li>
            </ul>
        </div>
    </template>

    <template id="masar_lockup" name="MASAR Pay lockup">
        <span class="masar-lockup" role="img" t-att-aria-label="copy['brand']['name'] + ' — ' + copy['brand']['tagline']"></span>
    </template>

    <template id="masar_lang" name="MASAR language switcher">
        <div class="masar-lang">
            <t t-set="lang_short" t-value="(lang or 'en').split('_')[0].upper()"/>
            <t t-if="website and len(website.language_ids) &gt; 1">
                <button type="button" class="masar-lang__toggle" aria-haspopup="listbox" t-att-aria-label="copy['lang_label']">
                    <t t-set="icon" t-value="'globe'"/>
                    <t t-call="masar_website.masar_icon"/>
                    <span class="masar-lang__code" t-out="lang_short"/>
                </button>
                <ul class="masar-lang__menu" role="listbox">
                    <t t-foreach="website.language_ids" t-as="lg">
                        <li>
                            <a t-attf-class="masar-lang__option #{lg.code == (lang or '') and 'is-active' or ''}" t-att-href="'/website/lang/%s?r=%s' % (lg.url_code, url_for(request.httprequest.path, lang_code=lg.code) or '/')" t-att-hreflang="lg.code">
                                <span t-out="lg.name"/>
                            </a>
                        </li>
                    </t>
                </ul>
            </t>
            <t t-else="">
                <span class="masar-lang__toggle masar-lang__toggle--static">
                    <t t-set="icon" t-value="'globe'"/>
                    <t t-call="masar_website.masar_icon"/>
                    <span class="masar-lang__code" t-out="lang_short"/>
                </span>
            </t>
        </div>
    </template>

    <template id="masar_inner_hero" name="MASAR inner hero">
        <section class="masar-hero masar-hero--page">
            <div class="masar-wrap masar-hero__copy">
                <p class="masar-eyebrow" t-out="hero['eyebrow']"/>
                <h1 class="masar-hero__title" t-out="hero['title']"/>
                <p class="masar-hero__lead" t-out="hero['lead']"/>
            </div>
        </section>
    </template>

    <template id="masar_blocks" name="MASAR page blocks">
        <t t-foreach="blocks" t-as="block">
            <section t-att-id="block['anchor'] or None" t-attf-class="masar-section masar-block masar-block--#{block['type']} #{'image' in block and block['image'] and 'masar-block--split' or ''}">
                <div class="masar-wrap">
                    <div class="masar-block__head">
                        <span t-if="'icon' in block and block['icon']" class="masar-block__icon" aria-hidden="true">
                            <t t-set="icon" t-value="block['icon']"/>
                            <t t-call="masar_website.masar_icon"/>
                        </span>
                        <div class="masar-block__intro">
                            <h2 t-if="block['title']" class="masar-heading" t-out="block['title']"/>
                            <p t-if="block['lead']" class="masar-lede" t-out="block['lead']"/>
                        </div>
                    </div>
                    <div t-if="block['type'] == 'prose'" class="masar-prose">
                        <p t-foreach="block['paragraphs']" t-as="paragraph" class="masar-lede" t-out="paragraph"/>
                    </div>
                    <figure t-if="'image' in block and block['image']" class="masar-split__figure">
                        <img class="masar-split__photo" t-attf-src="/masar_website/static/src/img/#{block['image']}?v=20260929-about" t-att-alt="'image_alt' in block and block['image_alt'] or block['title']" loading="lazy" width="1536" height="1024"/>
                    </figure>
                    <div t-if="block['type'] == 'cards'" class="masar-cards">
                        <article t-foreach="block['items']" t-as="item" t-att-id="item['anchor'] or None" class="masar-card">
                            <img t-if="'image' in item and item['image']" class="masar-card__media" t-attf-src="/masar_website/static/src/img/services-v2/#{item['image']}.webp?v=20260928-svc" t-att-alt="item['title']" loading="lazy" width="1280" height="720"/>
                            <header class="masar-card__header masar-card__heading">
                                <span t-if="'icon' in item and item['icon']" class="masar-card__icon" aria-hidden="true">
                                    <t t-set="icon" t-value="item['icon']"/>
                                    <t t-call="masar_website.masar_icon"/>
                                </span>
                                <h3 class="masar-card__title" t-out="item['title']"/>
                            </header>
                            <div class="masar-card__body">
                                <p class="masar-card__text" t-out="item['text']"/>
                                <ul t-if="item['points']" class="masar-points">
                                    <li t-foreach="item['points']" t-as="point" class="masar-points__item">
                                        <span class="masar-points__mark" aria-hidden="true"/>
                                        <span class="masar-points__text" t-out="point"/>
                                    </li>
                                </ul>
                            </div>
                        </article>
                    </div>
                    <div t-if="block['type'] == 'faq'" class="masar-faq">
                        <details t-foreach="block['items']" t-as="item" class="masar-faq__item">
                            <summary class="masar-faq__q"><span class="masar-faq__q-label" t-out="item['q']"/></summary>
                            <p class="masar-faq__a" t-out="item['a']"/>
                        </details>
                    </div>
                </div>
            </section>
        </t>
    </template>

    <template id="masar_closing" name="MASAR closing band">
        <section class="masar-band masar-closing" id="start">
            <div class="masar-wrap">
                <h2 class="masar-closing__title" t-out="copy['home']['closing']['title']"/>
                <p class="masar-closing__lead" t-out="copy['home']['closing']['lead']"/>
                <div class="masar-closing__actions">
                    <a class="masar-btn masar-btn--ghost masar-btn--forward" t-att-href="copy['actions']['contact_href']">
                        <span class="masar-btn__label" t-out="copy['actions']['contact']"/>
                    </a>
                    <a class="masar-btn masar-btn--primary masar-btn--forward" t-att-href="copy['actions']['get_started_href']">
                        <span class="masar-btn__label" t-out="copy['actions']['get_started']"/>
                    </a>
                </div>
            </div>
        </section>
    </template>

    <template id="masar_simple_page" name="MASAR catalog page">
        <t t-call="website.layout">
            <t t-set="copy" t-value="website.masar_public()"/>
            <t t-set="doc" t-value="copy['pages'][page_key]"/>
            <div id="wrap" t-attf-class="oe_structure masar-site masar-pay masar-page masar-page--#{page_key}">
                <t t-set="hero" t-value="doc['hero']"/>
                <t t-call="masar_website.masar_inner_hero"/>
                <t t-set="blocks" t-value="doc['blocks']"/>
                <t t-call="masar_website.masar_blocks"/>
                <t t-call="masar_website.masar_closing"/>
            </div>
        </t>
    </template>
</odoo>
