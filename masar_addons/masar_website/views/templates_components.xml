            <symbol id="masar-i-api" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m8 8-4 4 4 4M16 8l4 4-4 4M13 5.5l-2 13"/></symbol>
            <symbol id="masar-i-handshake" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M8 13.5 4.8 11a1.6 1.6 0 0 1 0-2.3L7.2 6.5 12 10l4.8-3.5 2.4 2.2a1.6 1.6 0 0 1 0 2.3L16 13.5"/><path d="m8.5 13 2.2 2.2a2 2 0 0 0 2.8 0L16 13"/><path d="M3.5 15.5 7 18M20.5 15.5 17 18"/></symbol>
