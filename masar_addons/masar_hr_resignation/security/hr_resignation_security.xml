<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="rule_resignation_own" model="ir.rule">
    <field name="name">Resignation: own</field>
    <field name="model_id" ref="model_hr_resignation"/>
    <field name="domain_force">[('employee_id', 'in', user.employee_ids.ids)]</field>
    <field name="groups" eval="[(4, ref('base.group_user'))]"/>
  </record>
  <record id="rule_resignation_hr" model="ir.rule">
    <field name="name">Resignation: HR all</field>
    <field name="model_id" ref="model_hr_resignation"/>
    <field name="domain_force">[(1, '=', 1)]</field>
    <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
  </record>
  <record id="rule_resignation_company" model="ir.rule">
    <field name="name">Resignation multi-company</field>
    <field name="model_id" ref="model_hr_resignation"/>
    <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    <field name="global" eval="True"/>
  </record>
</odoo>
