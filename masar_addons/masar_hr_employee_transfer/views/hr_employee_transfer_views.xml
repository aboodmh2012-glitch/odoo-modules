<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_employee_transfer_list" model="ir.ui.view">
    <field name="name">hr.employee.transfer.list</field>
    <field name="model">hr.employee.transfer</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="employee_id"/>
        <field name="transfer_date"/>
        <field name="source_company_id"/>
        <field name="dest_company_id"/>
        <field name="state"/>
      </list>
    </field>
  </record>
  <record id="view_employee_transfer_form" model="ir.ui.view">
    <field name="name">hr.employee.transfer.form</field>
    <field name="model">hr.employee.transfer</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_confirm" type="object" string="Confirm"
                  invisible="state != 'draft'" groups="hr.group_hr_manager"/>
          <button name="action_apply" type="object" string="Apply Transfer" class="btn-primary"
                  invisible="state != 'confirmed'" groups="hr.group_hr_manager"/>
          <button name="action_cancel" type="object" string="Cancel"
                  invisible="state not in ('draft', 'confirmed')" groups="hr.group_hr_manager"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="name" readonly="1"/>
              <field name="employee_id" readonly="state != 'draft'"/>
              <field name="transfer_date" readonly="state != 'draft'"/>
              <field name="responsible_id"/>
            </group>
            <group string="Destination">
              <field name="dest_company_id" readonly="state != 'draft'"/>
              <field name="dest_department_id" readonly="state != 'draft'"/>
              <field name="dest_job_id" readonly="state != 'draft'"/>
              <field name="dest_parent_id" readonly="state != 'draft'"/>
              <field name="dest_coach_id" readonly="state != 'draft'"/>
              <field name="dest_work_location_id" readonly="state != 'draft'"/>
            </group>
          </group>
          <group string="Source Snapshot" invisible="state == 'draft'">
            <field name="source_company_id"/>
            <field name="source_department_id"/>
            <field name="source_job_id"/>
            <field name="source_parent_id"/>
            <field name="source_coach_id"/>
            <field name="source_work_location_id"/>
          </group>
          <field name="note"/>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="action_hr_employee_transfer" model="ir.actions.act_window">
    <field name="name">Employee Transfers</field>
    <field name="res_model">hr.employee.transfer</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
