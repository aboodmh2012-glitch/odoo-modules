<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="rule_transfer_hr" model="ir.rule">
    <field name="name">Employee transfer: HR</field>
    <field name="model_id" ref="model_hr_employee_transfer"/>
    <field name="domain_force">[(1, '=', 1)]</field>
    <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
  </record>
  <!-- Visible if user has access to source OR destination company -->
  <record id="rule_transfer_company" model="ir.rule">
    <field name="name">Employee transfer multi-company (source or dest)</field>
    <field name="model_id" ref="model_hr_employee_transfer"/>
    <field name="domain_force">['|', '|', ('company_id', '=', False), ('company_id', 'in', company_ids), ('dest_company_id', 'in', company_ids)]</field>
    <field name="global" eval="True"/>
  </record>
</odoo>
