<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Org picker wizard shown after OAuth returns the administered organizations -->
  <record id="view_social_linkedin_link_wizard_form" model="ir.ui.view">
    <field name="name">social.linkedin.link.wizard.form</field>
    <field name="model">social.linkedin.link.wizard</field>
    <field name="arch" type="xml">
      <form string="Choose a LinkedIn organization">
        <p class="text-muted">
          Pick the LinkedIn organization to connect. The access token is filled
          automatically and stored only on the server.
        </p>
        <field name="line_ids">
          <list create="false" delete="false" edit="false">
            <field name="name"/>
            <field name="external_id" string="Organization ID"/>
            <button name="action_select" type="object" string="Connect"
                    class="btn-primary" icon="fa-link"/>
          </list>
        </field>
        <footer>
          <button string="Close" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_social_linkedin_link_wizard" model="ir.actions.act_window">
    <field name="name">Choose a LinkedIn organization</field>
    <field name="res_model">social.linkedin.link.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <!-- Entry point: "Connect LinkedIn" in the Social Accounts list Actions menu -->
  <record id="action_social_connect_linkedin" model="ir.actions.server">
    <field name="name">Connect LinkedIn</field>
    <field name="model_id" ref="social.model_social_account"/>
    <field name="binding_model_id" ref="social.model_social_account"/>
    <field name="binding_view_types">list</field>
    <field name="state">code</field>
    <field name="code">action = model.action_connect_linkedin()</field>
  </record>

  <!-- Refresh LinkedIn follower count (Insights) for selected accounts -->
  <record id="action_social_linkedin_followers" model="ir.actions.server">
    <field name="name">LinkedIn: refresh followers</field>
    <field name="model_id" ref="social.model_social_account"/>
    <field name="binding_model_id" ref="social.model_social_account"/>
    <field name="binding_view_types">form</field>
    <field name="state">code</field>
    <field name="code">
if records and records[:1].platform == 'linkedin':
    action = records[:1].action_linkedin_followers()
    </field>
  </record>
</odoo>
