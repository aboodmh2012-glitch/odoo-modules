<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="module_category_knowledge_control" model="ir.module.category">
    <field name="name">Knowledge Control</field>
    <field name="parent_id" ref="document_knowledge.module_category_knowledge"/>
    <field name="sequence">25</field>
  </record>
  <record id="kc_privilege" model="res.groups.privilege">
    <field name="name">Knowledge Control</field>
    <field name="category_id" ref="module_category_knowledge_control"/>
  </record>
  <record id="group_knowledge_control_user" model="res.groups">
    <field name="name">User</field>
    <field name="privilege_id" ref="kc_privilege"/>
    <field name="implied_ids" eval="[(4, ref('document_knowledge.group_document_user'))]"/>
  </record>
  <record id="group_knowledge_control_manager" model="res.groups">
    <field name="name">Manager</field>
    <field name="privilege_id" ref="kc_privilege"/>
    <field name="implied_ids" eval="[(4, ref('group_knowledge_control_user'))]"/>
    <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
  </record>
</odoo>
