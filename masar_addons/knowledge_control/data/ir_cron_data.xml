<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <record id="ir_cron_kc_review_due" model="ir.cron">
      <field name="name">Knowledge Control: mark review due</field>
      <field name="model_id" ref="document_page.model_document_page"/>
      <field name="state">code</field>
      <field name="code">model._cron_kc_review_due()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_kc_ack_overdue" model="ir.cron">
      <field name="name">Knowledge Control: acknowledgment overdue</field>
      <field name="model_id" ref="document_page.model_document_page"/>
      <field name="state">code</field>
      <field name="code">model._cron_kc_ack_overdue()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="active" eval="True"/>
    </record>
  </data>
</odoo>
