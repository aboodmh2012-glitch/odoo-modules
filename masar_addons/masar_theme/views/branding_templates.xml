<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Default browser tab title when none is set. -->
    <template id="masar_web_layout_title" inherit_id="web.layout" name="MASAR Default Title">
        <xpath expr="//title" position="replace">
            <title t-out="title or 'MASAR Pay'"/>
        </xpath>
    </template>

    <!-- website.login_layout replaces web.login_layout's card (incl. Powered by Odoo).
         Brand mark in login_templates.xml is the login identity; no powered-by xpath. -->

    <!-- Offline copy + button color (img replaced in webclient_templates.xml). -->
    <template id="masar_webclient_offline" inherit_id="web.webclient_offline" name="MASAR Offline Branding" priority="100">
        <xpath expr="//p" position="replace">
            <p>Check your network connection and come back here. Masar will load as soon as you're back online.</p>
        </xpath>
        <xpath expr="//style" position="replace">
            <style>
                body {
                    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Ubuntu, "Noto Sans", Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
                    padding:0;
                    margin:0;
                    background-color: #fff;
                    color: rgb(17, 24, 39);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    text-align: center;
                    height: 100vh;
                    width: 100vw;
                    user-select: none;
                }
                .card {
                    width: 80%;
                }
                .card img {
                    width: 96px;
                    height: auto;
                    filter: grayscale(.6);
                }
                .card button {
                    background-color: #006BFF;
                    color: #FFFFFF;
                    border: 1px solid #006BFF;
                    border-radius: .25rem;
                    padding: .5rem 1rem;
                    cursor: pointer;
                    font-size: 1.2rem;
                    font-weight: 500;
                }
            </style>
        </xpath>
    </template>
</odoo>
