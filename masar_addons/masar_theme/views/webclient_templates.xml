<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Backend chrome lives in web.webclient_bootstrap (not web.layout).
         Odoo 19 puts theme-color + apple-touch-icon in head_web here. -->
    <template id="masar_webclient_pwa_icon" inherit_id="web.webclient_bootstrap" name="MASAR Webclient PWA Chrome" priority="99">
        <xpath expr="//t[@t-set='head_web']" position="before">
            <t t-set="x_icon" t-value="'/masar_theme/static/src/img/masar-icon-192.png?v=20261004'"/>
        </xpath>
        <xpath expr="//meta[@name='theme-color']" position="replace">
            <meta name="theme-color" content="#071F3D"/>
        </xpath>
        <xpath expr="//link[@rel='apple-touch-icon']" position="replace">
            <link rel="apple-touch-icon" href="/masar_theme/static/src/img/masar-icon-180.png?v=20261004"/>
        </xpath>
    </template>
    <template id="masar_offline_icon" inherit_id="web.webclient_offline" name="MASAR Offline Icon" priority="99">
        <xpath expr="//img" position="replace">
            <img src="/masar_theme/static/src/img/masar-icon-192.png?v=20261004" alt="MASAR Pay"/>
        </xpath>
    </template>
</odoo>
