<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_telegram" model="ir.ui.view">
        <field name="name">social.account.telegram</field>
        <field name="model">social.account</field>
        <field name="inherit_id" ref="social.view_social_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='credentials']" position="inside">
                <div class="text-muted" invisible="platform != 'telegram'">
                    Token env: <code>SOCIAL_TELEGRAM_TOKEN</code>.
                    Webhook secret: <code>SOCIAL_TELEGRAM_WEBHOOK_SECRET</code>.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
