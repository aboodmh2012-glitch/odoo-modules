<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_discipline_sanction_type_form_yemen" model="ir.ui.view">
        <field name="name">hr.discipline.sanction.type.form.yemen</field>
        <field name="model">hr.discipline.sanction.type</field>
        <field name="inherit_id" ref="masar_hr_disciplinary.view_hr_discipline_sanction_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='has_financial_impact']" position="before">
                <field name="sanction_kind"/>
                <field name="requires_investigation"/>
            </xpath>
        </field>
    </record>
    <record id="view_hr_discipline_offense_type_form_yemen" model="ir.ui.view">
        <field name="name">hr.discipline.offense.type.form.yemen</field>
        <field name="model">hr.discipline.offense.type</field>
        <field name="inherit_id" ref="masar_hr_disciplinary.view_hr_discipline_offense_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="legal_reference"/>
            </xpath>
        </field>
    </record>
</odoo>
