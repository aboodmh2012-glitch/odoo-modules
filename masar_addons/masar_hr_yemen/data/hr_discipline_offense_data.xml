<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="offense_ye_att_late" model="hr.discipline.offense.type">
        <field name="name">تأخير متكرر عن مواعيد العمل</field>
        <field name="code">YE_ATT_LATE</field>
        <field name="classification">attendance</field>
        <field name="severity">1</field>
        <field name="requires_investigation" eval="False"/>
        <field name="allows_appeal" eval="True"/>
        <field name="appeal_deadline_days">30</field>
        <field name="approval_level">officer</field>
        <field name="legal_reference">قانون العمل م.90(4) / م.93 — لائحة الجزاءات</field>
        <field name="sanction_type_ids" eval="[(6, 0, [ref('sanction_ye_notice'), ref('sanction_ye_warning')])]"/>
        <field name="description"><![CDATA[<p>مخالفة مواعيد العمل. لا تُحوَّل كل حالة تأخير تلقائياً لجزاء — وفق سياسة الحضور.</p>]]></field>
    </record>
