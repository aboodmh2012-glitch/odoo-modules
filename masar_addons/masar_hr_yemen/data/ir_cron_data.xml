<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_probation_ending" model="ir.cron">
        <field name="name">MASAR HR: Probation ending reminder</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="state">code</field>
        <field name="code">model._cron_probation_ending_reminder()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field
            name="nextcall"
            eval="(DateTime.now() + timedelta(hours=2)).strftime('%Y-%m-%d %H:%M:%S')"
        />
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_discipline_warning_age" model="ir.cron">
        <field name="name">MASAR HR: Age out written notice/warning (Art. 95)</field>
        <field name="model_id" ref="masar_hr_disciplinary.model_hr_disciplinary_case"/>
        <field name="state">code</field>
        <field name="code">model._cron_age_out_warnings()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field
            name="nextcall"
            eval="(DateTime.now() + timedelta(hours=3)).strftime('%Y-%m-%d %H:%M:%S')"
        />
        <field name="active" eval="True"/>
    </record>
</odoo>
