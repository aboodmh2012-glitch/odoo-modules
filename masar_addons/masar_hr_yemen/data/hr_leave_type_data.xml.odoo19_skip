<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Yemen-oriented leave types. Do not delete Odoo defaults; HR may archive them. -->
    <record id="leave_type_ye_annual" model="hr.leave.type">
        <field name="name">إجازة سنوية (يمن)</field>
        <field name="requires_allocation" eval="True"/>
        <field name="employee_requests" eval="True"/>
        <field name="leave_validation_type">both</field>
        <field name="allocation_validation_type">hr</field>
        <field name="request_unit">day</field>
        <field name="time_type">leave</field>
        <field name="color">3</field>
    </record>
    <record id="leave_type_ye_sick" model="hr.leave.type">
        <field name="name">إجازة مرضية (يمن — شرائح الأجر وفق السياسة)</field>
        <field name="requires_allocation" eval="False"/>
        <field name="employee_requests" eval="True"/>
        <field name="leave_validation_type">hr</field>
        <field name="request_unit">day</field>
        <field name="time_type">leave</field>
        <field name="color">1</field>
    </record>
    <record id="leave_type_ye_maternity" model="hr.leave.type">
        <field name="name">إجازة وضع (70 يوماً+)</field>
        <field name="requires_allocation" eval="False"/>
        <field name="employee_requests" eval="True"/>
        <field name="leave_validation_type">hr</field>
        <field name="request_unit">day</field>
        <field name="time_type">leave</field>
        <field name="color">5</field>
    </record>
    <record id="leave_type_ye_iddah" model="hr.leave.type">
        <field name="name">إجازة عدة (وفاة الزوج)</field>
        <field name="requires_allocation" eval="False"/>
        <field name="employee_requests" eval="True"/>
        <field name="leave_validation_type">hr</field>
        <field name="request_unit">day</field>
        <field name="time_type">leave</field>
        <field name="color">8</field>
    </record>
    <record id="leave_type_ye_hajj" model="hr.leave.type">
        <field name="name">إجازة حج (مرة بعد 4 سنوات)</field>
        <field name="requires_allocation" eval="True"/>
        <field name="employee_requests" eval="True"/>
        <field name="leave_validation_type">both</field>
        <field name="allocation_validation_type">hr</field>
        <field name="request_unit">day</field>
        <field name="time_type">leave</field>
        <field name="color">4</field>
    </record>
    <record id="leave_type_ye_casual" model="hr.leave.type">
        <field name="name">إجازة عارضة</field>
        <field name="requires_allocation" eval="True"/>
        <field name="employee_requests" eval="True"/>
        <field name="leave_validation_type">manager</field>
        <field name="allocation_validation_type">hr</field>
        <field name="request_unit">day</field>
        <field name="time_type">leave</field>
        <field name="color">2</field>
    </record>
    <record id="leave_type_ye_unpaid" model="hr.leave.type">
        <field name="name">إجازة بدون أجر</field>
        <field name="requires_allocation" eval="False"/>
        <field name="employee_requests" eval="True"/>
        <field name="leave_validation_type">both</field>
        <field name="request_unit">day</field>
        <field name="time_type">leave</field>
        <field name="unpaid" eval="True"/>
        <field name="color">0</field>
    </record>
    <record id="leave_type_ye_public" model="hr.leave.type">
        <field name="name">عطلة رسمية</field>
        <field name="requires_allocation" eval="False"/>
        <field name="employee_requests" eval="False"/>
        <field name="leave_validation_type">no_validation</field>
        <field name="request_unit">day</field>
        <field name="time_type">leave</field>
        <field name="color">10</field>
    </record>
    <record id="leave_type_ye_injury" model="hr.leave.type">
        <field name="name">إصابة عمل / مرض مهني</field>
        <field name="requires_allocation" eval="False"/>
        <field name="employee_requests" eval="True"/>
        <field name="leave_validation_type">hr</field>
        <field name="request_unit">day</field>
        <field name="time_type">leave</field>
        <field name="color">9</field>
    </record>
</odoo>
