<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Short MASAR plans (Knowledge 17/18). HR can edit freely; Launch Plan on employee. -->
    <record id="plan_masar_onboarding" model="mail.activity.plan">
        <field name="name">انضمام (مسار)</field>
        <field name="res_model">hr.employee</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="plan_onb_docs" model="mail.activity.plan.template">
        <field name="plan_id" ref="plan_masar_onboarding"/>
        <field name="summary">استكمال الوثائق والعقد</field>
        <field name="sequence">10</field>
        <field name="activity_type_id" ref="mail.mail_activity_data_todo"/>
        <field name="responsible_type">manager</field>
        <field name="delay_count">0</field>
        <field name="delay_unit">days</field>
        <field name="delay_from">before_plan_date</field>
        <field name="note">هوية، عقد، NDA، إقرار سياسات — انظر معرفة 17) انضمام.</field>
    </record>
    <record id="plan_onb_access" model="mail.activity.plan.template">
        <field name="plan_id" ref="plan_masar_onboarding"/>
        <field name="summary">إنشاء الحسابات والصلاحيات</field>
        <field name="sequence">20</field>
        <field name="activity_type_id" ref="mail.mail_activity_data_todo"/>
        <field name="responsible_type">on_demand</field>
        <field name="delay_count">0</field>
        <field name="delay_unit">days</field>
        <field name="delay_from">before_plan_date</field>
        <field name="note">IT: بريد / أودو / أنظمة العمل حسب الحاجة.</field>
    </record>
    <record id="plan_onb_ppe" model="mail.activity.plan.template">
        <field name="plan_id" ref="plan_masar_onboarding"/>
        <field name="summary">تسليم العهد (إن لزم)</field>
        <field name="sequence">30</field>
        <field name="activity_type_id" ref="mail.mail_activity_data_todo"/>
        <field name="responsible_type">manager</field>
        <field name="delay_count">0</field>
        <field name="delay_unit">days</field>
        <field name="delay_from">before_plan_date</field>
    </record>
    <record id="plan_onb_start" model="mail.activity.plan.template">
        <field name="plan_id" ref="plan_masar_onboarding"/>
        <field name="summary">ضبط تاريخ العقد والتجربة ومباشرة العمل</field>
        <field name="sequence">40</field>
        <field name="activity_type_id" ref="mail.mail_activity_data_todo"/>
        <field name="responsible_type">manager</field>
        <field name="delay_count">0</field>
        <field name="delay_unit">days</field>
        <field name="delay_from">before_plan_date</field>
        <field name="note">عبّئ contract_date_start و trial_date_end والأجر على نسخة الموظف.</field>
    </record>

    <record id="plan_masar_offboarding" model="mail.activity.plan">
        <field name="name">مغادرة (مسار)</field>
        <field name="res_model">hr.employee</field>
        <field name="company_id" ref="base.main_company"/>
    </record>
    <record id="plan_off_handover" model="mail.activity.plan.template">
        <field name="plan_id" ref="plan_masar_offboarding"/>
        <field name="summary">تسليم الأعمال ونقل المعرفة</field>
        <field name="sequence">10</field>
        <field name="activity_type_id" ref="mail.mail_activity_data_todo"/>
        <field name="responsible_type">manager</field>
        <field name="delay_count">0</field>
        <field name="delay_unit">days</field>
        <field name="delay_from">before_plan_date</field>
    </record>
    <record id="plan_off_ppe" model="mail.activity.plan.template">
        <field name="plan_id" ref="plan_masar_offboarding"/>
        <field name="summary">إرجاع العهد والمعدات</field>
        <field name="sequence">20</field>
        <field name="activity_type_id" ref="mail.mail_activity_data_todo"/>
        <field name="responsible_type">manager</field>
        <field name="delay_count">0</field>
        <field name="delay_unit">days</field>
        <field name="delay_from">before_plan_date</field>
    </record>
    <record id="plan_off_access" model="mail.activity.plan.template">
        <field name="plan_id" ref="plan_masar_offboarding"/>
        <field name="summary">إلغاء الصلاحيات والحسابات</field>
        <field name="sequence">30</field>
        <field name="activity_type_id" ref="mail.mail_activity_data_todo"/>
        <field name="responsible_type">on_demand</field>
        <field name="delay_count">0</field>
        <field name="delay_unit">days</field>
        <field name="delay_from">before_plan_date</field>
        <field name="note">IT: عطّل الوصول في آخر يوم عمل.</field>
    </record>
    <record id="plan_off_clearance" model="mail.activity.plan.template">
        <field name="plan_id" ref="plan_masar_offboarding"/>
        <field name="summary">إخلاء الطرف + شهادة قطع العلاقة (م.41)</field>
        <field name="sequence">40</field>
        <field name="activity_type_id" ref="mail.mail_activity_data_todo"/>
        <field name="responsible_type">manager</field>
        <field name="delay_count">0</field>
        <field name="delay_unit">days</field>
        <field name="delay_from">before_plan_date</field>
        <field name="note">اطبع شهادة الخدمة من طلب الاستقالة، وأكمل إخلاء الطرف.</field>
    </record>
</odoo>
