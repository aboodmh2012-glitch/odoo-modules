<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_service_certificate" model="ir.actions.report">
        <field name="name">Service Certificate (Art. 41)</field>
        <field name="model">hr.resignation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">masar_hr_yemen.report_service_certificate</field>
        <field name="print_report_name">'Service_Certificate_%s' % (object.employee_id.name or object.name)</field>
        <field name="binding_model_id" ref="masar_hr_resignation.model_hr_resignation"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_service_certificate">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="font-size: 14px; direction: rtl; text-align: right;">
                        <h2 style="text-align: center;">وثيقة قطع علاقة العمل</h2>
                        <p style="text-align: center; color: #666;">
                            (قانون العمل — مادة 41)
                        </p>
                        <p>
                            تشهد شركة
                            <strong t-esc="o.company_id.name"/>
                            بأن:
                        </p>
                        <table class="table table-sm table-borderless" style="width: 100%;">
                            <tr>
                                <td style="width: 35%;"><strong>اسم الموظف</strong></td>
                                <td t-esc="o.employee_id.name"/>
                            </tr>
                            <tr>
                                <td><strong>الوظيفة</strong></td>
                                <td t-esc="o.employee_id.job_id.name or '-'"/>
                            </tr>
                            <tr>
                                <td><strong>القسم</strong></td>
                                <td t-esc="o.department_id.name or o.employee_id.department_id.name or '-'"/>
                            </tr>
                            <tr>
                                <td><strong>تاريخ الالتحاق</strong></td>
                                <td t-esc="o.joining_date or o.employee_id.contract_date_start or '-'"/>
                            </tr>
                            <tr>
                                <td><strong>تاريخ انتهاء الخدمة</strong></td>
                                <td t-esc="o.approved_last_day or o.expected_last_day or '-'"/>
                            </tr>
                            <tr>
                                <td><strong>نوع العمل / المهام</strong></td>
                                <td t-esc="o.employee_id.job_id.name or o.employee_id.job_title or '-'"/>
                            </tr>
                            <tr>
                                <td><strong>الأجر (أساسي)</strong></td>
                                <td>
                                    <t t-if="o.certificate_basic_wage">
                                        <span t-esc="o.certificate_basic_wage"/>
                                        <span t-esc="o.certificate_currency_id.name"/>
                                    </t>
                                    <t t-else="">-</t>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>سبب انتهاء العلاقة</strong></td>
                                <td>
                                    <t t-if="o.resignation_type == 'terminated'">إنهاء خدمة</t>
                                    <t t-else="">استقالة</t>
                                </td>
                            </tr>
                        </table>
                        <p class="mt-4">
                            مُنحت هذه الوثيقة مجاناً بناءً على طلب المعني / عند انتهاء العقد،
                            دون أن تتضمن ما يسيء إلى سمعته أو يقلل من فرص عمله.
                        </p>
                        <div class="row mt-5">
                            <div class="col-6">
                                <p>التاريخ: <span t-esc="o.approved_last_day or o.expected_last_day"/></p>
                            </div>
                            <div class="col-6" style="text-align: left;">
                                <p>ختم / توقيع الموارد البشرية</p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
