<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_masar_leave_allocation_preview_form" model="ir.ui.view">
        <field name="name">masar.leave.allocation.preview.form</field>
        <field name="model">masar.leave.allocation.preview</field>
        <field name="arch" type="xml">
            <form string="Leave allocation preview">
                <group>
                    <field name="company_id"/>
                    <field name="as_of_date"/>
                </group>
                <field name="note" readonly="1"/>
                <footer>
                    <button name="action_compute" type="object" string="Compute preview" class="btn-primary"/>
                    <button string="Close" special="cancel"/>
                </footer>
                <field name="line_ids" readonly="1">
                    <list>
                        <field name="employee_id"/>
                        <field name="contract_date_start"/>
                        <field name="service_months"/>
                        <field name="suggested_annual_days"/>
                        <field name="suggested_casual_days"/>
                        <field name="missing_contract_start"/>
                    </list>
                </field>
            </form>
        </field>
    </record>
    <record id="action_masar_leave_allocation_preview" model="ir.actions.act_window">
        <field name="name">Leave allocation preview</field>
        <field name="res_model">masar.leave.allocation.preview</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
