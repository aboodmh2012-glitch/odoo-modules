<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="module_category_masar_hr_disciplinary" model="ir.module.category">
    <field name="name">HR Disciplinary</field>
    <field name="sequence">26</field>
  </record>
  <record id="disciplinary_privilege" model="res.groups.privilege">
    <field name="name">Disciplinary</field>
    <field name="category_id" ref="module_category_masar_hr_disciplinary"/>
  </record>

  <record id="group_disciplinary_employee" model="res.groups">
    <field name="name">Employee</field>
    <field name="privilege_id" ref="disciplinary_privilege"/>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
  </record>
  <record id="group_disciplinary_line_manager" model="res.groups">
    <field name="name">Line Manager</field>
    <field name="privilege_id" ref="disciplinary_privilege"/>
    <field name="implied_ids" eval="[(4, ref('group_disciplinary_employee'))]"/>
  </record>
  <!-- Investigator is a sibling of officer, not a parent -->
  <record id="group_disciplinary_investigator" model="res.groups">
    <field name="name">Investigator</field>
    <field name="privilege_id" ref="disciplinary_privilege"/>
    <field name="implied_ids" eval="[(4, ref('group_disciplinary_employee'))]"/>
  </record>
  <record id="group_disciplinary_hr_officer" model="res.groups">
    <field name="name">HR Officer</field>
    <field name="privilege_id" ref="disciplinary_privilege"/>
    <field name="implied_ids" eval="[(4, ref('group_disciplinary_line_manager')), (4, ref('hr.group_hr_user'))]"/>
  </record>
  <record id="group_disciplinary_hr_manager" model="res.groups">
    <field name="name">HR Manager</field>
    <field name="privilege_id" ref="disciplinary_privilege"/>
    <field name="implied_ids" eval="[(4, ref('group_disciplinary_hr_officer')), (4, ref('group_disciplinary_investigator')), (4, ref('hr.group_hr_manager'))]"/>
  </record>
  <record id="group_disciplinary_approver" model="res.groups">
    <field name="name">Disciplinary Approver</field>
    <field name="privilege_id" ref="disciplinary_privilege"/>
    <field name="implied_ids" eval="[(4, ref('group_disciplinary_hr_manager'))]"/>
  </record>
  <record id="group_disciplinary_payroll_officer" model="res.groups">
    <field name="name">Payroll Officer</field>
    <field name="privilege_id" ref="disciplinary_privilege"/>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
  </record>

  <!-- Settings admins and Employees administrators get full disciplinary rights.
       (Approver implies HR Manager / Officer / Investigator in this privilege.) -->
  <record id="base.group_system" model="res.groups">
    <field name="implied_ids" eval="[(4, ref('group_disciplinary_approver')), (4, ref('group_disciplinary_payroll_officer'))]"/>
  </record>
  <record id="hr.group_hr_manager" model="res.groups">
    <field name="implied_ids" eval="[(4, ref('group_disciplinary_approver'))]"/>
  </record>
</odoo>
