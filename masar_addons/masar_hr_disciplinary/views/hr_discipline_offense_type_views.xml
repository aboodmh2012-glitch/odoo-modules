<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_hr_discipline_offense_type_tree" model="ir.ui.view">
    <field name="name">hr.discipline.offense.type.list</field>
    <field name="model">hr.discipline.offense.type</field>
    <field name="arch" type="xml">
      <list>
        <field name="code"/>
        <field name="name"/>
        <field name="classification"/>
        <field name="severity"/>
        <field name="approval_level"/>
        <field name="company_id" groups="base.group_multi_company"/>
      </list>
    </field>
  </record>
  <record id="view_hr_discipline_offense_type_form" model="ir.ui.view">
    <field name="name">hr.discipline.offense.type.form</field>
    <field name="model">hr.discipline.offense.type</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="code"/>
              <field name="classification"/>
              <field name="severity"/>
              <field name="active"/>
            </group>
            <group>
              <field name="policy_page_id"/>
              <field name="approval_level"/>
              <field name="requires_investigation"/>
              <field name="allows_appeal"/>
              <field name="appeal_deadline_days"/>
              <field name="has_financial_impact"/>
              <field name="escalation_enabled"/>
              <field name="recurrence_period_days"/>
              <field name="company_id" groups="base.group_multi_company"/>
            </group>
          </group>
          <group string="Possible Sanctions">
            <field name="sanction_type_ids" widget="many2many_tags" nolabel="1"/>
          </group>
          <field name="description"/>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_hr_discipline_offense_type" model="ir.actions.act_window">
    <field name="name">Offense Types (Regulation)</field>
    <field name="res_model">hr.discipline.offense.type</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
