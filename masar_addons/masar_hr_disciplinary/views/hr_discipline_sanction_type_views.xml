<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_hr_discipline_sanction_type_tree" model="ir.ui.view">
    <field name="name">hr.discipline.sanction.type.list</field>
    <field name="model">hr.discipline.sanction.type</field>
    <field name="arch" type="xml">
      <list>
        <field name="sequence" widget="handle"/>
        <field name="code"/>
        <field name="name"/>
        <field name="has_financial_impact"/>
        <field name="requires_approval_level"/>
      </list>
    </field>
  </record>
  <record id="view_hr_discipline_sanction_type_form" model="ir.ui.view">
    <field name="name">hr.discipline.sanction.type.form</field>
    <field name="model">hr.discipline.sanction.type</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="code"/>
            <field name="sequence"/>
            <field name="has_financial_impact"/>
            <field name="requires_approval_level"/>
            <field name="active"/>
            <field name="company_id" groups="base.group_multi_company"/>
            <field name="description"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_hr_discipline_sanction_type" model="ir.actions.act_window">
    <field name="name">Sanction Types</field>
    <field name="res_model">hr.discipline.sanction.type</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
