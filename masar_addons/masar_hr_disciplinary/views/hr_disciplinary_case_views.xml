<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_hr_disciplinary_case_tree" model="ir.ui.view">
    <field name="name">hr.disciplinary.case.list</field>
    <field name="model">hr.disciplinary.case</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="employee_id"/>
        <field name="offense_type_id"/>
        <field name="severity"/>
        <field name="incident_date"/>
        <field name="state"/>
        <field name="company_id" groups="base.group_multi_company"/>
      </list>
    </field>
  </record>

  <record id="view_hr_disciplinary_case_form" model="ir.ui.view">
    <field name="name">hr.disciplinary.case.form</field>
    <field name="model">hr.disciplinary.case</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_submit" type="object" string="Submit"
                  invisible="state != 'draft'"
                  groups="masar_hr_disciplinary.group_disciplinary_hr_officer"/>
          <button name="action_start_investigation" type="object" string="Start Investigation"
                  invisible="state not in ('submitted', 'investigation')"
                  groups="masar_hr_disciplinary.group_disciplinary_investigator"/>
          <button name="action_request_statement" type="object" string="Request Statement"
                  invisible="state not in ('investigation', 'submitted')"
                  groups="masar_hr_disciplinary.group_disciplinary_investigator"/>
          <button name="action_submit_statement" type="object" string="Submit Statement"
                  invisible="state != 'awaiting_statement'"/>
          <button name="action_submit_recommendation" type="object" string="Submit Recommendation"
                  invisible="state not in ('recommendation', 'investigation', 'awaiting_statement')"
                  groups="masar_hr_disciplinary.group_disciplinary_investigator"/>
          <button name="action_hr_review_done" type="object" string="Send for Approval"
                  invisible="state != 'hr_review'"
                  groups="masar_hr_disciplinary.group_disciplinary_hr_officer"/>
          <button name="action_approve_decision" type="object" string="Approve Decision"
                  class="btn-primary"
                  invisible="state != 'pending_approval'"
                  groups="masar_hr_disciplinary.group_disciplinary_hr_officer"/>
          <button name="action_submit_appeal" type="object" string="Submit Appeal"
                  invisible="state not in ('awaiting_appeal', 'decided')"/>
          <button name="action_resolve_appeal" type="object" string="Resolve Appeal"
                  invisible="state != 'appeal_review'"
                  groups="masar_hr_disciplinary.group_disciplinary_approver"/>
          <button name="action_close" type="object" string="Close"
                  invisible="state not in ('decided', 'awaiting_appeal')"
                  groups="masar_hr_disciplinary.group_disciplinary_hr_officer"/>
          <button name="action_cancel" type="object" string="Cancel"
                  invisible="state in ('closed', 'cancelled')"
                  groups="masar_hr_disciplinary.group_disciplinary_hr_manager"/>
          <button name="action_formal_amend_open" type="object" string="Formal Amend"
                  invisible="state not in ('decided', 'closed', 'awaiting_appeal')"
                  groups="masar_hr_disciplinary.group_disciplinary_approver"/>
          <field name="state" widget="statusbar"
                 statusbar_visible="draft,submitted,investigation,awaiting_statement,recommendation,hr_review,pending_approval,decided,closed"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1><field name="name" readonly="1"/></h1>
          </div>
          <group>
            <group>
              <field name="employee_id" readonly="state != 'draft'"/>
              <field name="department_id"/>
              <field name="manager_id"/>
              <field name="incident_date" readonly="state != 'draft'"/>
              <field name="company_id" groups="base.group_multi_company"/>
            </group>
            <group>
              <field name="offense_type_id" readonly="state != 'draft'"/>
              <field name="policy_page_id"/>
              <field name="severity"/>
              <field name="prior_offense_count"/>
              <field name="investigator_id"/>
            </group>
          </group>
          <notebook>
            <page string="Incident" name="incident">
              <field name="incident_summary" readonly="state != 'draft'"/>
              <field name="evidence_attachment_ids" widget="many2many_binary"/>
            </page>
            <page string="Investigation" name="investigation"
                  groups="masar_hr_disciplinary.group_disciplinary_investigator,masar_hr_disciplinary.group_disciplinary_hr_officer">
              <field name="investigation_notes"/>
            </page>
            <page string="Employee Statement" name="statement">
              <field name="employee_statement"/>
              <field name="statement_attachment_ids" widget="many2many_binary"/>
            </page>
            <page string="Recommendation &amp; Decision" name="decision"
                  groups="masar_hr_disciplinary.group_disciplinary_hr_officer">
              <group>
                <field name="recommendation"/>
                <field name="recommended_sanction_id"/>
                <field name="hr_review_notes"/>
                <field name="decided_sanction_id"/>
                <field name="decision_notes"/>
                <field name="decision_date"/>
                <field name="decided_by_id"/>
                <field name="financial_amount"/>
                <field name="currency_id" invisible="1"/>
                <field name="payroll_ready" readonly="1"/>
              </group>
            </page>
            <page string="Appeal" name="appeal">
              <group>
                <field name="appeal_allowed"/>
                <field name="appeal_deadline"/>
                <field name="appeal_text"/>
                <field name="appeal_outcome"
                         groups="masar_hr_disciplinary.group_disciplinary_approver"/>
                <field name="appeal_decision_notes"
                         groups="masar_hr_disciplinary.group_disciplinary_approver"/>
              </group>
            </page>
            <page string="Amendment" name="amendment"
                  groups="masar_hr_disciplinary.group_disciplinary_hr_manager">
              <field name="amendment_reason"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_hr_disciplinary_case_search" model="ir.ui.view">
    <field name="name">hr.disciplinary.case.search</field>
    <field name="model">hr.disciplinary.case</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="employee_id"/>
        <field name="offense_type_id"/>
        <filter name="open" string="Open" domain="[('state', 'not in', ('closed', 'cancelled'))]"/>
        <filter name="decided" string="Decided" domain="[('state', 'in', ('decided', 'awaiting_appeal', 'closed'))]"/>
        <filter name="payroll" string="Payroll Ready" domain="[('payroll_ready', '=', True)]"/>
        <group>
          <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
          <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_hr_disciplinary_case" model="ir.actions.act_window">
    <field name="name">Disciplinary Cases</field>
    <field name="res_model">hr.disciplinary.case</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'search_default_open': 1}</field>
  </record>
</odoo>
