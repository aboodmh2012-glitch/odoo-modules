<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_social_youtube_link_wizard_form" model="ir.ui.view">
    <field name="name">social.youtube.link.wizard.form</field>
    <field name="model">social.youtube.link.wizard</field>
    <field name="arch" type="xml">
      <form string="Choose a YouTube channel">
        <p class="text-muted">
          Pick the YouTube channel to connect. Tokens are stored only on the server.
        </p>
        <field name="line_ids">
          <list create="false" delete="false" edit="false">
            <field name="name"/>
            <field name="external_id" string="Channel ID"/>
            <button name="action_select" type="object" string="Connect"
                    class="btn-primary" icon="fa-link"/>
          </list>
        </field>
        <footer>
          <button string="Close" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_social_youtube_link_wizard" model="ir.actions.act_window">
    <field name="name">Choose a YouTube channel</field>
    <field name="res_model">social.youtube.link.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <record id="action_social_connect_youtube" model="ir.actions.server">
    <field name="name">Connect YouTube</field>
    <field name="model_id" ref="social.model_social_account"/>
    <field name="binding_model_id" ref="social.model_social_account"/>
    <field name="binding_view_types">list</field>
    <field name="state">code</field>
    <field name="code">action = model.action_connect_youtube()</field>
  </record>

  <record id="action_social_youtube_stats" model="ir.actions.server">
    <field name="name">YouTube: refresh stats</field>
    <field name="model_id" ref="social.model_social_account"/>
    <field name="binding_model_id" ref="social.model_social_account"/>
    <field name="binding_view_types">form</field>
    <field name="state">code</field>
    <field name="code">
if records and records[:1].platform == 'youtube':
    action = records[:1].action_youtube_stats()
    </field>
  </record>
</odoo>
