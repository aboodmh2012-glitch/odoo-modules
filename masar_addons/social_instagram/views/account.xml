<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_instagram" model="ir.ui.view">
        <field name="name">social.account.instagram</field>
        <field name="model">social.account</field>
        <field name="inherit_id" ref="social.view_social_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='external_account_id']" position="after">
                <div class="alert alert-info mb-0" role="alert"
                     invisible="platform != 'instagram' or connection_status == 'connected'">
                    Use <b>Accounts → Connect Facebook</b>, then pick the Instagram Business account linked to your Page.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
