<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="rule_reg_own" model="ir.rule">
    <field name="name">Attendance regularization: own</field>
    <field name="model_id" ref="model_hr_attendance_regularization"/>
    <field name="domain_force">[('employee_id', 'in', user.employee_ids.ids)]</field>
    <field name="groups" eval="[(4, ref('base.group_user'))]"/>
  </record>
  <record id="rule_reg_officer" model="ir.rule">
    <field name="name">Attendance regularization: officer</field>
    <field name="model_id" ref="model_hr_attendance_regularization"/>
    <field name="domain_force">[(1, '=', 1)]</field>
    <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_officer'))]"/>
  </record>
  <record id="rule_reg_company" model="ir.rule">
    <field name="name">Attendance regularization multi-company</field>
    <field name="model_id" ref="model_hr_attendance_regularization"/>
    <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    <field name="global" eval="True"/>
  </record>
</odoo>
