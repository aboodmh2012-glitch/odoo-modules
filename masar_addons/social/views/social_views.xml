<odoo>
  <record id="view_social_account_list" model="ir.ui.view">
    <field name="name">social.account.list</field>
    <field name="model">social.account</field>
    <field name="arch" type="xml">
      <list create="0" string="Social Accounts">
        <header>
          <button name="action_connect_facebook" type="object" string="Connect Facebook" class="btn-primary" display="always" groups="social.group_social_admin"/>
          <button name="action_connect_instagram" type="object" string="Connect Instagram" display="always" groups="social.group_social_admin"/>
        </header>
        <field name="name"/>
        <field name="platform"/>
        <field name="connection_status" widget="badge"
               decoration-success="connection_status == 'connected'"
               decoration-warning="connection_status == 'not_connected'"
               decoration-danger="connection_status == 'error'"/>
        <field name="publishing_enabled" optional="show"/>
        <field name="messaging_enabled" optional="show"/>
        <field name="last_sync_at" optional="show"/>
        <field name="company_id" groups="base.group_multi_company" optional="hide"/>
        <field name="active" optional="hide"/>
      </list>
    </field>
  </record>

  <record id="view_social_account_form" model="ir.ui.view">
    <field name="name">social.account.form</field>
    <field name="model">social.account</field>
    <field name="arch" type="xml">
      <form create="0" string="Social Account">
        <header>
          <button name="action_connect_provider" type="object" string="Reconnect"
                  class="btn-primary" groups="social.group_social_admin"
                  invisible="platform == 'unconfigured'"/>
          <field name="connection_status" widget="statusbar"
                 statusbar_visible="not_connected,connected,error"/>
        </header>
        <sheet>
          <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
          <group>
            <group string="Account">
              <field name="platform" readonly="1"/>
              <field name="external_account_id" string="External account ID" readonly="1"/>
              <field name="company_id" groups="base.group_multi_company"/>
              <field name="user_ids" widget="many2many_tags"/>
              <field name="active"/>
            </group>
            <group string="Connection">
              <field name="publishing_enabled"/>
              <field name="messaging_enabled"/>
              <field name="last_sync_at" readonly="1"/>
              <field name="token_expiry" readonly="1" groups="social.group_social_admin"/>
              <field name="granted_scopes" readonly="1" groups="social.group_social_admin"/>
            </group>
          </group>
          <group string="Technical" name="credentials" groups="base.group_system">
            <field name="access_token" invisible="1"/>
            <field name="credential_env" invisible="1"/>
            <field name="webhook_secret_env" invisible="1"/>
            <field name="webhook_key" readonly="1"/>
            <field name="webhook_user_id"/>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="view_social_post_list" model="ir.ui.view">
    <field name="name">social.post.list</field><field name="model">social.post</field>
    <field name="arch" type="xml"><list decoration-danger="failed_count &gt; 0"><field name="name"/><field name="state" widget="badge"/><field name="validation_status"/><field name="scheduled_at"/><field name="published_count"/><field name="failed_count"/><field name="author_id"/><field name="company_id" groups="base.group_multi_company"/></list></field>
  </record>
  <record id="view_social_post_search" model="ir.ui.view">
    <field name="name">social.post.search</field><field name="model">social.post</field>
    <field name="arch" type="xml"><search><field name="name"/><field name="content"/><field name="campaign_id"/><filter name="drafts" string="Drafts" domain="[('state','=','draft')]"/><filter name="approvals" string="Approvals" domain="[('state','=','review')]"/><filter name="scheduled" string="Scheduled" domain="[('target_ids.state','=','queued')]"/><filter name="published" string="Published" domain="[('target_ids.state','=','published')]"/><filter name="failed" string="Needs attention" domain="[('target_ids.state','in',['failed','uncertain'])]"/><separator/><filter name="my_posts" string="My posts" domain="[('author_id','=',uid)]"/><group><filter name="group_state" string="Status" context="{'group_by':'state'}"/><filter name="group_campaign" string="Campaign" context="{'group_by':'campaign_id'}"/></group></search></field>
  </record>
  <record id="view_social_post_form" model="ir.ui.view">
    <field name="name">social.post.form</field><field name="model">social.post</field>
    <field name="arch" type="xml"><form>
      <header>
        <button name="action_request_review" string="Request review" type="object" class="oe_highlight" invisible="state != 'draft'"/>
        <button name="action_approve" string="Approve content" type="object" groups="social.group_social_publisher" invisible="state not in ['draft','review']"/>
        <button name="action_publish" string="Publish / schedule" type="object" class="oe_highlight" groups="social.group_social_publisher" invisible="state != 'approved'" confirm="Queue the approved content for all pending accounts?"/>
        <button name="action_reset_draft" string="Reset to draft" type="object" invisible="state == 'draft'"/>
        <button name="action_cancel" string="Cancel pending deliveries" type="object" invisible="state == 'cancelled'"/>
        <field name="state" widget="statusbar" statusbar_visible="draft,review,approved"/>
      </header>
      <sheet>
        <div class="oe_title"><h1><field name="name" placeholder="Post title" readonly="state != 'draft'"/></h1></div>
        <group><field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/><field name="author_id"/><field name="campaign_id" readonly="state != 'draft'"/><field name="scheduled_at" readonly="state != 'draft'" help="Leave empty to publish when queued."/></group>
        <field name="content" placeholder="Write your post…" readonly="state != 'draft'"/>
        <field name="attachment_ids" widget="many2many_binary" readonly="state != 'draft'"/>
        <notebook><page string="Accounts and delivery">
          <field name="target_ids" readonly="state != 'draft'">
            <list editable="bottom"><field name="company_id" column_invisible="True"/><field name="account_id" domain="[('company_id','=',parent.company_id)]"/><field name="platform_content" optional="show"/><field name="scheduled_at"/><field name="state" widget="badge"/><field name="external_url" widget="url" optional="hide"/><field name="error_message" optional="show"/><button name="action_retry" string="Retry" type="object" invisible="state != 'failed'" groups="social.group_social_publisher"/></list>
          </field>
        </page></notebook>
      </sheet><chatter/>
    </form></field>
  </record>
  <record id="view_social_post_calendar" model="ir.ui.view">
    <field name="name">social.post.calendar</field><field name="model">social.post</field>
    <field name="arch" type="xml"><calendar string="Publication plan" date_start="scheduled_at" color="state" quick_create="false"><field name="name"/><field name="state"/></calendar></field>
  </record>
  <record id="view_social_post_kanban" model="ir.ui.view">
    <field name="name">social.post.kanban</field><field name="model">social.post</field>
    <field name="arch" type="xml"><kanban default_group_by="state" records_draggable="false" quick_create="false"><templates><t t-name="card"><field name="name" class="fw-bold"/><field name="content"/><div class="d-flex gap-2"><field name="state" widget="badge"/><field name="scheduled_at"/></div><div>Published: <field name="published_count"/> · Needs attention: <field name="failed_count"/></div></t></templates></kanban></field>
  </record>
  <record id="view_social_target_list" model="ir.ui.view">
    <field name="name">social.target.list</field><field name="model">social.post.target</field>
    <field name="arch" type="xml"><list create="false" delete="false"><field name="post_id"/><field name="account_id"/><field name="state" widget="badge"/><field name="scheduled_at"/><field name="published_at"/><field name="error_message"/><button name="action_retry" type="object" string="Retry" invisible="state != 'failed'" groups="social.group_social_publisher"/></list></field>
  </record>
  <record id="view_social_target_pivot" model="ir.ui.view">
    <field name="name">social.target.pivot</field><field name="model">social.post.target</field>
    <field name="arch" type="xml"><pivot string="Publication results"><field name="platform" type="row"/><field name="account_id" type="row"/><field name="state" type="col"/></pivot></field>
  </record>
  <record id="view_social_target_graph" model="ir.ui.view">
    <field name="name">social.target.graph</field><field name="model">social.post.target</field>
    <field name="arch" type="xml"><graph string="Publication results" type="bar" stacked="1"><field name="platform"/><field name="state"/></graph></field>
  </record>
  <record id="view_social_target_search" model="ir.ui.view">
    <field name="name">social.target.search</field><field name="model">social.post.target</field>
    <field name="arch" type="xml"><search>
      <field name="post_id"/><field name="account_id"/>
      <filter name="published" string="Published" domain="[('state','=','published')]"/>
      <filter name="queued" string="Queued / scheduled" domain="[('state','in',['queued','publishing'])]"/>
      <filter name="attention" string="Needs attention" domain="[('state','in',['failed','uncertain'])]"/>
      <group>
        <filter name="group_platform" string="Platform" context="{'group_by':'platform'}"/>
        <filter name="group_account" string="Account" context="{'group_by':'account_id'}"/>
        <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
        <filter name="group_published" string="Published (month)" context="{'group_by':'published_at:month'}"/>
      </group>
    </search></field>
  </record>
  <record id="view_social_conversation_list" model="ir.ui.view">
    <field name="name">social.conversation.list</field>
    <field name="model">social.conversation</field>
    <field name="arch" type="xml">
      <list create="false"
            js_class="social_inbox_list"
            class="o_social_inbox_list"
            default_order="last_message_at desc"
            sample="1">
        <field name="last_message_at" string="Date" widget="datetime"/>
        <field name="name" string="Interaction" widget="social_interaction"/>
        <field name="preview" column_invisible="1"/>
        <field name="platform" column_invisible="1"/>
        <field name="kind" column_invisible="1"/>
        <field name="partner_id" column_invisible="1"/>
        <field name="needs_reply" column_invisible="1"/>
        <field name="priority" widget="social_priority" optional="show"/>
        <field name="assigned_user_id" string="Assignee" widget="many2one_avatar_user" optional="show"/>
        <field name="state" widget="badge"
                  decoration-info="state == 'open'"
                  decoration-warning="state == 'waiting'"
                  decoration-success="state == 'done'"
                  optional="hide"/>
        <field name="account_id" optional="hide"/>
        <field name="important" optional="hide"/>
        <field name="activity_ids" widget="list_activity" optional="hide"/>
      </list>
    </field>
  </record>
  <record id="view_social_conversation_search" model="ir.ui.view">
    <field name="name">social.conversation.search</field>
    <field name="model">social.conversation</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="preview"/>
        <field name="account_id"/>
        <field name="partner_id"/>
        <field name="assigned_user_id"/>
        <field name="platform"/>
        <filter name="needs_reply" string="Needs reply" domain="[('needs_reply','=',True),('spam','=',False)]"/>
        <filter name="mine" string="Assigned to me" domain="[('assigned_user_id','=',uid)]"/>
        <filter name="unassigned" string="Unassigned" domain="[('assigned_user_id','=',False)]"/>
        <separator/>
        <filter name="type_message" string="Messages" domain="[('kind','=','private')]"/>
        <filter name="type_comment" string="Comments" domain="[('kind','=','comment')]"/>
        <filter name="type_mention" string="Mentions" domain="[('kind','=','mention')]"/>
        <separator/>
        <filter name="priority_high" string="High priority" domain="[('priority','=','2')]"/>
        <filter name="important" string="Important" domain="[('important','=',True)]"/>
        <separator/>
        <filter name="state_open" string="Open" domain="[('state','=','open')]"/>
        <filter name="state_waiting" string="Waiting" domain="[('state','=','waiting')]"/>
        <filter name="done" string="Done" domain="[('state','=','done')]"/>
        <filter name="spam" string="Spam" domain="[('spam','=',True)]"/>
        <separator/>
        <filter name="filter_last_message" string="Last message" date="last_message_at"/>
        <group>
          <filter name="group_platform" string="Platform" context="{'group_by':'platform'}"/>
          <filter name="group_account" string="Account" context="{'group_by':'account_id'}"/>
          <filter name="group_kind" string="Type" context="{'group_by':'kind'}"/>
          <filter name="group_assignee" string="Assignee" context="{'group_by':'assigned_user_id'}"/>
          <filter name="group_priority" string="Priority" context="{'group_by':'priority'}"/>
          <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
        </group>
        <searchpanel>
          <field name="platform" string="Platform" enable_counters="1"/>
          <field name="kind" string="Type" enable_counters="1"/>
          <field name="state" string="Status" enable_counters="1"/>
          <field name="priority" string="Priority" enable_counters="1"/>
        </searchpanel>
      </search>
    </field>
  </record>
  <record id="view_social_conversation_form" model="ir.ui.view">
    <field name="name">social.conversation.form</field>
    <field name="model">social.conversation</field>
    <field name="arch" type="xml">
      <form create="false">
        <header>
          <button name="action_assign_me" string="Assign to me" type="object" invisible="assigned_user_id == uid"/>
          <button name="action_done" string="Mark done" type="object" class="btn-primary" invisible="state == 'done'"/>
          <field name="state" widget="statusbar" statusbar_visible="open,waiting,done"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button class="oe_stat_button" type="object" name="action_assign_me" icon="fa-user" invisible="assigned_user_id">
              <div class="o_stat_info"><span class="o_stat_text">Unassigned</span></div>
            </button>
          </div>
          <widget name="web_ribbon" title="Needs reply" bg_color="text-bg-danger" invisible="not needs_reply"/>
          <widget name="web_ribbon" title="Spam" bg_color="text-bg-warning" invisible="not spam"/>
          <div class="oe_title">
            <h1><field name="name" readonly="1"/></h1>
            <h5 class="text-muted" invisible="not preview"><field name="preview" readonly="1"/></h5>
          </div>
          <group>
            <group string="Interaction">
              <field name="account_id" readonly="1"/>
              <field name="platform" readonly="1"/>
              <field name="kind" readonly="1"/>
              <field name="profile_id" readonly="1"/>
              <field name="partner_id"/>
              <field name="last_message_at" readonly="1"/>
              <field name="external_url" widget="url" invisible="not external_url"/>
            </group>
            <group string="Workflow">
              <field name="assigned_user_id" widget="many2one_avatar_user"/>
              <field name="priority" widget="priority"/>
              <field name="important"/>
              <field name="spam"/>
              <field name="needs_reply" readonly="1"/>
            </group>
          </group>
          <group string="Reply to customer" invisible="state == 'done'">
            <field name="reply_text" nolabel="1" placeholder="Write a public reply… Internal chatter notes are never sent."/>
            <div>
              <button name="action_send_reply" type="object" string="Send reply" class="btn btn-primary" confirm="Send this reply to the customer on the connected platform?"/>
            </div>
          </group>
          <notebook>
            <page string="Delivery history" name="delivery">
              <field name="delivery_ids">
                <list create="false" edit="false" delete="false">
                  <field name="direction"/>
                  <field name="state" widget="badge"/>
                  <field name="sent_at"/>
                  <field name="external_id" optional="hide"/>
                  <field name="error_message" optional="show"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="view_social_conversation_kanban" model="ir.ui.view">
    <field name="name">social.conversation.kanban</field>
    <field name="model">social.conversation</field>
    <field name="arch" type="xml">
      <kanban default_group_by="state" quick_create="false" sample="1" class="o_social_inbox_kanban">
        <field name="needs_reply"/>
        <field name="important"/>
        <field name="kind"/>
        <field name="platform"/>
        <field name="preview"/>
        <field name="priority"/>
        <field name="partner_id"/>
        <field name="last_message_at"/>
        <progressbar field="activity_state" colors='{"planned":"success","today":"warning","overdue":"danger"}'/>
        <templates>
          <t t-name="card">
            <div class="o_social_inbox_card">
              <div class="d-flex justify-content-between align-items-start gap-2">
                <div class="d-flex align-items-center gap-2 min-w-0">
                  <field name="partner_id" widget="many2one_avatar" class="me-1"/>
                  <div class="min-w-0">
                    <field name="name" class="fw-bold text-truncate"/>
                    <div class="o_social_preview"><field name="preview"/></div>
                  </div>
                </div>
                <field name="priority" widget="social_priority"/>
              </div>
              <div class="d-flex justify-content-between align-items-center mt-2 gap-2">
                <div class="d-flex gap-1 align-items-center">
                  <field name="kind" widget="badge"/>
                  <span t-if="record.needs_reply.raw_value" class="badge text-bg-danger">Needs reply</span>
                  <span t-if="record.important.raw_value" class="badge text-bg-warning">Important</span>
                </div>
                <field name="assigned_user_id" widget="many2one_avatar_user"/>
              </div>
              <div class="text-muted small mt-1 d-flex justify-content-between">
                <field name="account_id"/>
                <field name="last_message_at"/>
              </div>
              <div><field name="activity_ids" widget="kanban_activity"/></div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>
  <record id="view_social_conversation_activity" model="ir.ui.view">
    <field name="name">social.conversation.activity</field>
    <field name="model">social.conversation</field>
    <field name="arch" type="xml"><activity string="Inbox"><templates><div t-name="activity-box"><field name="name"/><field name="account_id" muted="1"/></div></templates></activity></field>
  </record>
  <record id="view_social_profile_list" model="ir.ui.view">
    <field name="name">social.profile.list</field><field name="model">social.profile</field>
    <field name="arch" type="xml"><list><field name="name"/><field name="username"/><field name="account_id"/><field name="partner_id"/><field name="last_seen_at"/></list></field>
  </record>
  <record id="view_social_profile_form" model="ir.ui.view">
    <field name="name">social.profile.form</field><field name="model">social.profile</field>
    <field name="arch" type="xml"><form><header><button name="action_create_contact" string="Create contact" type="object" invisible="partner_id"/></header><sheet><group><field name="name"/><field name="username"/><field name="account_id" readonly="id"/><field name="external_profile_id" readonly="id"/><field name="partner_id"/><field name="last_seen_at"/><field name="active"/></group></sheet></form></field>
  </record>
  <record id="action_social_dashboard" model="ir.actions.act_window"><field name="name">Dashboard</field><field name="res_model">social.post.target</field><field name="view_mode">graph,pivot,list</field><field name="context">{'search_default_group_platform':1,'search_default_group_state':1}</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">No publication results yet</p><p>Publications appear here once approved posts are published to connected accounts.</p></field></record>
  <record id="action_social_posts" model="ir.actions.act_window"><field name="name">Posts</field><field name="res_model">social.post</field><field name="view_mode">kanban,list,calendar,form</field></record>
  <record id="action_social_inbox" model="ir.actions.act_window"><field name="name">Inbox</field><field name="res_model">social.conversation</field><field name="view_mode">list,kanban,activity,form</field><field name="context">{'search_default_needs_reply':1}</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Inbox zero</p><p>Customer messages and public comments from connected accounts appear here. Filter by channel, type, priority or assignee.</p></field></record>
  <record id="action_social_monitor" model="ir.actions.act_window"><field name="name">Monitor · Public interactions</field><field name="res_model">social.conversation</field><field name="view_mode">list,form</field><field name="domain">[('kind','!=','private')]</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">Public interactions appear when a connected platform supports them.</p></field></record>
  <record id="action_social_profiles" model="ir.actions.act_window"><field name="name">Connections</field><field name="res_model">social.profile</field><field name="view_mode">list,form</field></record>
  <record id="action_social_accounts" model="ir.actions.act_window">
    <field name="name">Social Accounts</field>
    <field name="res_model">social.account</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">No linked accounts yet</p>
      <p>Connect Facebook or Instagram to add the first account. Accounts are created from provider OAuth; there is no manual account setup.</p>
    </field>
  </record>
  <record id="action_social_connect_facebook" model="ir.actions.server">
    <field name="name">Connect Facebook</field>
    <field name="model_id" ref="model_social_account"/>
    <field name="binding_model_id" ref="model_social_account"/>
    <field name="binding_view_types">list</field>
    <field name="state">code</field>
    <field name="code">action = model.action_connect_facebook()</field>
  </record>
  <record id="action_social_connect_instagram" model="ir.actions.server">
    <field name="name">Connect Instagram</field>
    <field name="model_id" ref="model_social_account"/>
    <field name="binding_model_id" ref="model_social_account"/>
    <field name="binding_view_types">list</field>
    <field name="state">code</field>
    <field name="code">action = model.action_connect_instagram()</field>
  </record>
  <record id="action_social_tiers" model="ir.actions.act_window"><field name="name">Social approval rules</field><field name="res_model">tier.definition</field><field name="view_mode">list,form</field><field name="domain">[('model','=','social.post')]</field><field name="context" eval="{'default_model_id': ref('model_social_post')}"/></record>
  <menuitem id="menu_social_root" name="Social" sequence="45" groups="social.group_social_user,social.group_social_admin"/>
  <menuitem id="menu_social_dashboard" name="Dashboard" parent="menu_social_root" action="action_social_dashboard" sequence="10" groups="social.group_social_user"/>
  <menuitem id="menu_social_posts" name="Posts" parent="menu_social_root" action="action_social_posts" sequence="20" groups="social.group_social_user"/>
  <menuitem id="menu_social_inbox" name="Inbox" parent="menu_social_root" action="action_social_inbox" sequence="30" groups="social.group_social_user"/>
  <menuitem id="menu_social_monitor" name="Monitor" parent="menu_social_root" action="action_social_monitor" sequence="40" groups="social.group_social_user"/>
  <menuitem id="menu_social_connections" name="Connections" parent="menu_social_root" action="action_social_profiles" sequence="50" groups="social.group_social_user"/>
  <menuitem id="menu_social_configuration" name="Configuration" parent="menu_social_root" sequence="70" groups="social.group_social_admin,base.group_system"/>
  <menuitem id="menu_social_tiers" name="Approval rules" parent="menu_social_configuration" action="action_social_tiers" sequence="20" groups="base.group_system"/>
</odoo>
