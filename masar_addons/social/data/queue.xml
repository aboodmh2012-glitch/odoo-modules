<odoo>
<record id="channel_social" model="queue.job.channel"><field name="name">social</field><field name="parent_id" ref="queue_job.channel_root"/></record>
<record id="job_publish" model="queue.job.function"><field name="model_id" ref="model_social_post_target"/><field name="method">_job_publish</field><field name="channel_id" ref="channel_social"/><field name="retry_pattern" eval="{1:60, 2:180, 3:600, 4:1800}"/></record>
<record id="job_reply" model="queue.job.function"><field name="model_id" ref="model_social_delivery"/><field name="method">_job_send</field><field name="channel_id" ref="channel_social"/><field name="retry_pattern" eval="{1:60, 2:180, 3:600, 4:1800}"/></record>
</odoo>