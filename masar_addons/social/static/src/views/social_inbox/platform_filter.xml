<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="social.PlatformFilter">
        <div class="o_social_platform_filter d-flex align-items-center flex-wrap gap-2 px-3 py-2 border-bottom bg-view">
            <span class="text-muted small text-uppercase fw-bold me-1">Channels</span>
            <button type="button"
                    class="o_social_platform_chip btn btn-link p-0"
                    t-att-class="{ 'o_social_platform_chip_active': state.active === 'all' }"
                    t-on-click="() => this.onSelectAll()"
                    title="All interactions">
                <span class="o_social_platform_all">ALL</span>
            </button>
            <t t-foreach="state.platforms" t-as="platform" t-key="platform.media_type">
                <button type="button"
                        class="o_social_platform_chip btn btn-link p-0"
                        t-att-class="{ 'o_social_platform_chip_active': state.active === platform.media_type }"
                        t-on-click="() => this.onSelectPlatform(platform.media_type)"
                        t-att-title="platform.name">
                    <img t-att-src="platformIcon(platform)"
                         t-att-alt="platform.name"
                         class="o_social_platform_chip_img"/>
                </button>
            </t>
        </div>
    </t>
</templates>
